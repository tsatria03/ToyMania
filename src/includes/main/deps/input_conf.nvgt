class input_conf {
	private input_bind@ binds;

	input_conf() {
		@binds = input_bind();
	}

	// Action management

	void add_action(const string&in action) {
		binds.add_action(action);
	}

	void remove_action(const string&in action) {
		binds.remove_action(action);
	}

	bool has_action(const string&in action) const {
		return binds.has_action(action);
	}

	string[]@ get_actions() const {
		return binds.get_actions();
	}

	void clear() {
		binds.clear();
	}

	// Keyboard binding
	// combo can be a single key name like "SPACE" or a chord like "LSHIFT+SPACE".

	void bind_key(const string&in action, const string&in combo, trigger_type trigger = TRIGGER_PRESS) {
		binds.bind_key(action, combo, trigger);
	}

	void bind_key(const string&in action, uint key, trigger_type trigger = TRIGGER_PRESS) {
		binds.bind_key(action, key, trigger);
	}

	// Removes all combos for the action whose primary key matches.
	void unbind_key(const string&in action, uint key) {
		binds.unbind_key(action, key);
	}

	// Removes a specific combo, e.g. unbind_key("jump", "LSHIFT", KEY_SPACE).
	void unbind_key(const string&in action, const string&in combo, uint key) {
		binds.unbind_key(action, combo, key);
	}

	void clear_keyboard_action(const string&in action) {
		binds.clear_keyboard_action(action);
	}

	// Joystick binding

	void bind_joystick_button(const string&in action, int button, trigger_type trigger = TRIGGER_PRESS) {
		binds.bind_joystick_button(action, button, trigger);
	}

	void unbind_joystick_button(const string&in action, int button) {
		binds.unbind_joystick_button(action, button);
	}

	void clear_joystick_action(const string&in action) {
		binds.clear_joystick_action(action);
	}

	void set_joystick(joystick@ j) {
		binds.set_joystick(j);
	}

	// State queries

	bool action_pressed(const string&in action) {
		return binds.action_pressed(action);
	}

	bool action_down(const string&in action) const {
		return binds.action_down(action);
	}

	bool action_released(const string&in action) {
		return binds.action_released(action);
	}

	bool action_up(const string&in action) const {
		return binds.action_up(action);
	}

	bool action_repeating(const string&in action) {
		return binds.action_repeating(action);
	}

	// Checks each binding using its own assigned trigger type.
	bool action_triggered(const string&in action) {
		return binds.action_triggered(action);
	}

	// INI file I/O
	// Keyboard format: action=KEY  or  action=MOD+KEY  or  action=MOD+KEY:trigger
	// Joystick format: action=BUTTON_0  or  action=BUTTON_0:trigger

	bool load_keyboard(const string&in path) {
		return binds.load_keyboard(path);
	}

	bool save_keyboard(const string&in path) const {
		return binds.save_keyboard(path);
	}

	string get_keyboard_action_string(const string&in action) const {
		return binds.get_keyboard_action_string(action);
	}

	bool load_joystick(const string&in path) {
		return binds.load_joystick(path);
	}

	bool save_joystick(const string&in path) const {
		return binds.save_joystick(path);
	}
}
